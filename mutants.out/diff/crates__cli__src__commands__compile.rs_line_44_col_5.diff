 /// A shape as its extents, such as `[2, 4]`.
 pub(crate) fn extents(shape: &Shape) -> String {
     let extents: Vec<String> = shape.dims().iter().map(|dim| dim.get().to_string()).collect();
     format!("[{}]", extents.join(", "))
 }
