     /// A buffer for `tensor` at the next aligned offset of the blob.
     fn constant(&mut self, tensor: &HostTensor) -> Result<BufferId, CompileError> {
         let length = u64::try_from(self.constants.len()).map_err(|_| CompileError::TooLarge)?;
